{
  "name": "local-event-discovery",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "build:client": "esbuild src/assets/js/main.ts --bundle --minify --target=esnext --outdir=src/assets/js --entry-names=[name]",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:build-import:d1": "node scripts/d1/build-d1-import-sql.mjs",
    "db:import:d1": "node scripts/d1/apply-d1-import.mjs",
    "db:verify:d1": "node scripts/d1/verify-d1-import.mjs",
    "agent:production-regression": "node scripts/agents/production-regression.mjs"
  },
  "dependencies": {
    "@ts-rest/core": "^3.52.0",
    "drizzle-orm": "^0.30.0",
    "hono": "^4.12.5",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260329.1",
    "@hono/node-server": "^1.19.11",
    "@types/jsdom": "^28.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "axe-core": "^4.9.0",
    "drizzle-kit": "^0.21.0",
    "esbuild": "^0.27.3",
    "fast-check": "^3.19.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "wrangler": "^4.78.0"
  }
}
